<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1" />
<title>QRShield — Scan &amp; Verify</title>
<meta name="description" content="Scan any QR code and get an instant, on-device safety check before you ever open the link." />

<link rel="manifest" href="manifest.json" />
<meta name="theme-color" content="#0a0a0a" />
<link rel="icon" type="image/png" sizes="32x32" href="icons/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="icons/favicon-16.png" />
<link rel="apple-touch-icon" href="icons/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="QRShield" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

<link rel="stylesheet" href="style.css" />
</head>
<body>

<div class="app-shell">

  <!-- ===================== HEADER ===================== -->
  <header class="topbar">
    <div class="brand">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22">
          <rect x="3" y="3" width="7" height="7" rx="1.4" fill="currentColor"/>
          <rect x="14" y="3" width="7" height="7" rx="1.4" fill="currentColor" opacity="0.55"/>
          <rect x="3" y="14" width="7" height="7" rx="1.4" fill="currentColor" opacity="0.55"/>
          <rect x="14.5" y="14.5" width="3" height="3" rx="0.8" fill="currentColor"/>
          <rect x="18" y="14.5" width="3" height="3" rx="0.8" fill="currentColor" opacity="0.3"/>
          <rect x="14.5" y="18" width="3" height="3" rx="0.8" fill="currentColor" opacity="0.3"/>
          <rect x="18" y="18" width="3" height="3" rx="0.8" fill="currentColor"/>
        </svg>
      </span>
      <span class="brand-name">QR<em>Shield</em></span>
    </div>
    <div class="status-chip" id="engineStatus">
      <span class="dot"></span> <span id="engineStatusText">On-device engine ready</span>
    </div>
  </header>

  <!-- ===================== SCAN VIEW ===================== -->
  <main class="view" id="view-scan" data-view>

    <section class="scanner-card">
      <div class="scanner-frame" id="scannerFrame">
        <video id="video" playsinline muted autoplay></video>
        <canvas id="canvas" hidden></canvas>

        <div class="viewfinder" aria-hidden="true">
          <span class="corner tl"></span>
          <span class="corner tr"></span>
          <span class="corner bl"></span>
          <span class="corner br"></span>
          <div class="scanline"></div>
        </div>

        <div class="scanner-idle" id="scannerIdle">
          <div class="idle-icon">
            <svg viewBox="0 0 24 24" width="40" height="40">
              <path fill="currentColor" d="M4 4h6v6H4V4zm2 2v2h2V6H6zm8-2h6v6h-6V4zm2 2v2h2V6h-2zM4 14h6v6H4v-6zm2 2v2h2v-2H6zm10-2h2v2h-2v-2zm4 0h2v2h-2v-2zm-4 4h2v2h-2v-2zm4 0h2v2h-2v-2zm-2-2h2v2h-2v-2z"/>
            </svg>
          </div>
          <p>Camera is off</p>
          <span>Point at a QR code — nothing is sent anywhere until you decide</span>
        </div>
      </div>

      <div class="scanner-controls">
        <button class="btn btn-primary btn-glow" id="startBtn">
          <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M4 4h16v16H4z" opacity="0"/><path fill="currentColor" d="M17 10.5V7a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3.5l4 4v-11l-4 4z"/></svg>
          Start scanning
        </button>
        <button class="btn btn-ghost" id="uploadBtn">
          <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 3l4 4h-3v6h-2V7H8l4-4zM5 20v-6h2v4h10v-4h2v6H5z"/></svg>
          Upload image
        </button>
        <input type="file" id="fileInput" accept="image/*" hidden />
      </div>

      <p class="privacy-note">
        <svg viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M12 2l7 3v6c0 5-3.4 8.7-7 11-3.6-2.3-7-6-7-11V5l7-3z"/></svg>
        Scanning and analysis happen entirely on this device. QRShield never contacts the destination automatically — that would expose your IP to it first.
      </p>
    </section>

  </main>

  <!-- ===================== RESULT VIEW ===================== -->
  <main class="view" id="view-result" data-view hidden>
    <section class="result-card">

      <div class="verdict-banner" id="verdictBanner">
        <div class="verdict-icon" id="verdictIcon"></div>
        <div class="verdict-copy">
          <h2 id="verdictTitle">Analyzing…</h2>
          <p id="verdictSubtitle">Running local checks</p>
        </div>
        <div class="verdict-score" id="verdictScore" title="Risk score"></div>
      </div>

      <div class="content-block">
        <span class="content-label" id="contentTypeLabel">Detected content</span>
        <div class="content-value" id="contentValue"></div>
      </div>

      <div class="reasons-block" id="reasonsBlock">
        <span class="content-label">What we found</span>
        <ul id="reasonsList"></ul>
      </div>

      <div class="advisory-block" id="advisoryBlock" hidden>
        <span class="content-label">Privacy note</span>
        <p id="advisoryText"></p>
      </div>

      <div class="result-actions">
        <button class="btn btn-ghost" id="copyBtn">Copy content</button>
        <button class="btn btn-outline" id="rescanBtn">Scan another</button>
        <button class="btn btn-primary" id="proceedBtn">Open anyway</button>
      </div>

    </section>
  </main>

  <!-- ===================== SETTINGS VIEW ===================== -->
  <main class="view" id="view-settings" data-view hidden>
    <section class="settings-card">

      <div class="settings-group">
        <h3>Scanning</h3>
        <label class="switch-row">
          <div>
            <span class="switch-label">Strict mode</span>
            <span class="switch-help">Flags more borderline patterns as caution. Recommended.</span>
          </div>
          <span class="switch"><input type="checkbox" id="strictToggle" checked /><span class="slider"></span></span>
        </label>
        <label class="switch-row">
          <div>
            <span class="switch-label">Haptic feedback</span>
            <span class="switch-help">Vibrate briefly when a code is detected.</span>
          </div>
          <span class="switch"><input type="checkbox" id="hapticToggle" checked /><span class="slider"></span></span>
        </label>
      </div>

      <div class="settings-group">
        <div class="group-header-row">
          <h3>Scan history</h3>
          <button class="btn btn-tiny" id="clearHistoryBtn">Clear all</button>
        </div>
        <ul class="history-list" id="historyList">
          <li class="history-empty" id="historyEmpty">No scans yet — your history stays on this device only.</li>
        </ul>
      </div>

      <div class="settings-group">
        <h3>How QRShield decides</h3>
        <p class="about-text">
          Every scan is checked against on-device rules only: link structure, lookalike domains, link-shorteners that hide
          a destination, insecure connections, unusual characters, and QR types that carry sensitive data (Wi-Fi
          passwords, contact cards, one-time-passcode secrets). Nothing is uploaded, and no destination link is ever
          opened automatically. This is a heuristic check, not a guarantee — always be cautious with codes from
          untrusted sources.
        </p>
      </div>

      <div class="settings-group">
        <h3>About</h3>
        <p class="about-text">QRShield · version 1.0 · Installable, offline-capable, no accounts, no notifications, no tracking.</p>
      </div>

    </section>
  </main>

  <!-- ===================== BOTTOM NAV ===================== -->
  <nav class="bottom-nav">
    <button class="nav-btn is-active" id="navScan" data-nav="scan">
      <svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M3 3h7v2H5v5H3V3zm18 0v7h-2V5h-5V3h7zM3 14h2v5h5v2H3v-7zm18 0v7h-7v-2h5v-5h2z"/></svg>
      <span>Scan</span>
    </button>
    <button class="nav-btn" id="navSettings" data-nav="settings">
      <svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M19.4 13a7.6 7.6 0 000-2l2-1.6-2-3.4-2.4 1a7.6 7.6 0 00-1.7-1L14.9 3h-3.8l-.4 2.4a7.6 7.6 0 00-1.7 1l-2.4-1-2 3.4L6.6 11a7.6 7.6 0 000 2l-2 1.6 2 3.4 2.4-1a7.6 7.6 0 001.7 1l.4 2.4h3.8l.4-2.4a7.6 7.6 0 001.7-1l2.4 1 2-3.4-2-1.6zM13 15.5a3.5 3.5 0 110-7 3.5 3.5 0 010 7z"/></svg>
      <span>Settings</span>
    </button>
  </nav>

</div>

<div class="toast" id="toast"></div>

<script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.min.js"></script>
<script src="app.js"></script>
</body>
</html>
